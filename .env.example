# Backend only. Copy to .env (ignored); never upload it as a static asset.
NODE_ENV=development
PORT=8002
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/chie_mailbox
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_ORIGIN=http://127.0.0.1:8002
# Keep disabled until the owner verifies paid HTTP API access.
INBOX_MODE=disabled
FORMSPREE_FORM_ID=mzeekake
FORMSPREE_API_TOKEN=
